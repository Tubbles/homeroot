{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(tmux set-window-option monitor-activity:*)",
      "Bash(tmux display-message -p:*)",
      "Bash(gsettings list-recursively:*)",
      "Bash(claude --version)",
      "Bash(npm list:*)",
      "Bash(snap list *)",
      "Bash(git push:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hook-notification.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "xhigh",
      "autoCompactWindow": 500000
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh",
      "autoCompactWindow": 500000
    }
  },
  "autoCompactWindow": 500000,
  "tui": "fullscreen",
  "prefersReducedMotion": true,
  "theme": "dark",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
