{
    "aspell.check": "off",
    "colorcolumn": [
        72,
        80,
        120
    ],
    "colorscheme": "one-dark-j",
    "colorscheme.dark": "one-dark-j",
    "colorscheme.follow-system": true,
    "colorscheme.light": "everforest-light-j",
    "editorconfig": true,
    "filemanager.showhidden": true,
    "*.sjson": {
        "filetype": "json"
    },
    "ft:proto": {
        "tabsize": 2
    },
    "ft:odin": {
        "tabsize": 8,
        "tabstospaces": false,
    },
    "hlsearch": true,
    "hlselection": true,
    "lockbindings": true,
    "lsp": true,
    "matchbracestyle": "highlight",
    "mkparents": true,
    "parsecursor": true,
    "paste": true,
    "pathbar": true,
    "pathdisplay": "smart",
    "quittoscratch": true,
    "reload": "auto",
    "rmtrailingws": true,
    "savecursor": true,
    "saveundo": true,
    "showchars": "tab=→,space= ,itab=|→,ispace=|",
    "softwrap": true,
    "statusformatl": "$(modified)$(overwrite) $(opt:filetype) | $(opt:fileformat) | $(opt:encoding)",
    "statusformatr": " $(icase.indicator) | $(line),$(col)",
    "tabstospaces": true,
    // "treesitter": true,
    "textfilterselectword": false
}
